{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2022"],
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "e2e",
    "playwright.config.ts",
    "scripts/**/*.ts"
  ]
}

{
  "name": "europa-rail-club",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests e2e *.ts package.json tsconfig.json README.md DEVELOPMENT_PLAN.md RULES_VERIFICATION.md DATA_SOURCES.md ART_DIRECTION.md",
    "format:check": "prettier --check src tests e2e *.ts package.json tsconfig.json README.md DEVELOPMENT_PLAN.md RULES_VERIFICATION.md DATA_SOURCES.md ART_DIRECTION.md",
    "test:e2e": "playwright test",
    "test:data": "vitest run tests/europe.test.ts",
    "test:games": "vitest run tests/europe-game.test.ts"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.21",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}

{
  "name": "europa-rail-club",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src tests e2e *.ts package.json tsconfig.json README.md DEVELOPMENT_PLAN.md RULES_VERIFICATION.md DATA_SOURCES.md ART_DIRECTION.md server src/multiplayer DEPLOYMENT.md scripts/*.mjs",
    "format:check": "prettier --check src tests e2e *.ts package.json tsconfig.json README.md DEVELOPMENT_PLAN.md RULES_VERIFICATION.md DATA_SOURCES.md ART_DIRECTION.md server DEPLOYMENT.md scripts/*.mjs",
    "test:e2e": "playwright test",
    "test:data": "vitest run tests/europe.test.ts",
    "test:games": "vitest run tests/europe-game.test.ts",
    "server": "npm run build:server && node --env-file-if-exists=.env .server-build/main.mjs",
    "test:multiplayer": "vitest run tests/multiplayer.test.ts",
    "build:server": "node scripts/build-server.mjs",
    "start:server": "node --env-file-if-exists=.env .server-build/main.mjs"
  },
  "dependencies": {
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.56.1",
    "@types/node": "22.15.21",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}

# Development defaults. Production requires DATABASE_URL and HTTPS origins.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173
LOCAL_DATABASE_DIR=.local-data/postgres
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# NODE_ENV=production
# VITE_GAME_SERVER_URL=https://your-game-server.example.com
# Never put database passwords or seat tokens in VITE_* variables.
